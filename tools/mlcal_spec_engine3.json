{
  "_doc": "mlcal spec for engine v3. tune: parameter paths in src/params3.js (dot paths; array index = number; '*' = one segment). Bounds: lo/hi absolute, or rel = [v/rel, v*rel]; log scale when lo > 0 unless log:false. 'paths' + lo/hi = one multiplier on several current values. See research/model_mlcal.md.",
  "engine": "src/engine3.js",
  "params": "src/params3.js",
  "inject": "opts",
  "backtest": "data/derived/backtest_dev.json",
  "priors": "data/derived/mlcal_priors_asof.json",
  "defaults": { "rel": 1.6 },
  "tune": [
    { "path": "combA", "lo": 0.6, "hi": 1.8, "log": false },
    { "path": "combB", "lo": 0.6, "hi": 1.8, "log": false },
    { "path": "kPM", "lo": 10, "hi": 160 },
    { "path": "kAcc", "lo": 40, "hi": 600 },
    { "path": "kKD", "lo": 60, "hi": 900 },
    { "path": "kTdPM", "lo": 12, "hi": 180 },
    { "path": "kTdAcc", "lo": 3, "hi": 48 },
    { "path": "strikeScale", "rel": 1.25 },
    { "path": "kdScale", "rel": 1.6 },
    { "path": "kdInstant", "rel": 1.5, "max": 0.95 },
    { "path": "subConvScale", "rel": 1.6 },
    { "path": "tdOddsScale", "rel": 1.4 },
    { "path": "form.out", "lo": 0.03, "hi": 0.45 },
    { "name": "form.powchin", "paths": ["form.pow", "form.chin"], "lo": 0.4, "hi": 1.6 },
    { "path": "form.vol", "lo": 0.1, "hi": 1.0 },
    { "path": "judge.sharedSd", "rel": 1.8 }
  ],
  "objective": {
    "wWin": 1.0,
    "wBins": 0.5,
    "wBase": 1.0,
    "wStat": 0.0,
    "brWeight": 0.003,
    "binPrior": 1.0,
    "winPrior": 0.5,
    "pClip": 0.005
  }
}
