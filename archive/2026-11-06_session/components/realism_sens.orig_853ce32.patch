+
+// ---------------------------------------------------------------- 1. flag off = the engine before the change
+console.log("=== flag off reproduces the engine before the change ===");
+const fixture = fs.existsSync(FIX) ? JSON.parse(fs.readFileSync(FIX, "utf8")) : {};
+const refDirArg = argv("--ref-dir");
