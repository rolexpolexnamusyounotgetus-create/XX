+  L.push("");
+  L.push(`${bs.n} fights on ${bs.events} event cards; paired event-cluster bootstrap 95% CIs (on - off; negative = flag on better for losses).`);
+  L.push("");
+  L.push("| Metric | n | flag off | flag on | on - off | 95% CI |");
+  L.push("|---|---|---|---|---|---|");
