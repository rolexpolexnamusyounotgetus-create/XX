+
+function pi7Of(fights) {
+  const c = [0, 0, 0, 0, 0, 0, 0];
+  for (const f of fights) c[f.real.bin]++;
+  const n = fights.length;
+  return c.map((x, k) => (x + c[6 - k]) / (2 * n));
