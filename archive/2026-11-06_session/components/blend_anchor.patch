+  loyoWeights: Object.fromEntries(YEARS.map((Y) => [Y, fitCache["loyoN" + Y + "|" + NOLINE.join("+")] && fitCache["loyoN" + Y + "|" + NOLINE.join("+")].w]))
+};
+const OUTJSON = TAG ? path.join(OUTDIR, "eval_" + TAG + ".json") : D("blend_anchor.json");
