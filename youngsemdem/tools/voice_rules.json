{
  "version": 1,
  "updated": "2026-11-09",
  "about": "Rules for tools/voice_lint.js (and the copy checks in tools/qa.js). Sources: docs/BRIEF.md 0, 1.3, 2.3 to 2.6 and 9 (claims to avoid); docs/research/05-voice-dua-lipa.md 4 to 6; docs/research/00-lead-factcheck.md. Each rule: id, severity (error | warning), gate (the BRIEF check it feeds; qa.js fails that GATE on an error), lang (en | es | any), scope (any | html: rendered page text only, not data files), flags (default 'iu'), patterns (JavaScript regex source), message, suggest. 'allow' patterns cancel a hit when they match the text around it. Add a rule here rather than in code.",
  "skipKeys": [
    "note",
    "notes",
    "editorNote",
    "source",
    "sources",
    "url",
    "urls",
    "href",
    "link",
    "cite",
    "never",
    "avoid",
    "banned",
    "bannedWords",
    "dont",
    "donts",
    "kills",
    "doNot",
    "rationale",
    "why",
    "checker",
    "research",
    "internal",
    "svg",
    "icon",
    "verified",
    "confidence",
    "id",
    "slug",
    "key",
    "pattern",
    "regex",
    "mirror",
    "license",
    "licenseUrl",
    "photographer",
    "photographerHandle",
    "downloadUrl",
    "src",
    "poster",
    "query",
    "mapQuery",
    "hash",
    "token",
    "placeholder",
    "sourceTitles",
    "use"
  ],
  "copyKeys": [
    "en",
    "es",
    "caption",
    "burnedInText"
  ],
  "seriousTones": [
    "serious",
    "calm"
  ],
  "noEmojiKeyPrefixes": [
    "error.",
    "warning.",
    "seo.",
    "legal.",
    "footer.",
    "demo.",
    "a11y.",
    "nudge.",
    "form.",
    "state.",
    "join."
  ],
  "noEmojiFiles": [
    "data/legal.js",
    "data/civic.js",
    "data/newsletter.js"
  ],
  "letterPaths": [
    "newsletter.issue.letter",
    "newsletter.letter",
    "newsletter.issues"
  ],
  "longCopyChars": 280,
  "exclamationsPerBlock": 1,
  "rules": [
    {
      "id": "native-imagery",
      "severity": "error",
      "gate": "B33",
      "lang": "en",
      "category": "brand safety",
      "patterns": [
        "\\bwarriors?\\b",
        "\\btribes?\\b",
        "\\btribal\\b",
        "\\bchiefs?\\b",
        "\\bbraves?\\b",
        "\\bwar ?paint\\b",
        "\\bwar (?:cry|whoop|chant|dance)\\b",
        "\\bpow[- ]?wows?\\b",
        "\\bspirit animals?\\b",
        "\\bon the warpath\\b",
        "\\bcircle the wagons\\b",
        "\\bNoles\\b",
        "\\bSeminoles\\b",
        "\\btomahawks?\\b",
        "\\bscalp(?:s|ed|ing)?\\b",
        "\\btotem(?: pole)?\\b",
        "\\bpeace pipe\\b",
        "\\bheaddress(?:es)?\\b",
        "\\bIndian giver\\b"
      ],
      "message": "Native imagery or language (the county is named for the Seminole people; BRIEF 0.3, report 00).",
      "suggest": "Use the county itself: Lake Monroe, SunRail, the Celery City, crews, friends."
    },
    {
      "id": "native-imagery-es",
      "severity": "error",
      "gate": "B33",
      "lang": "es",
      "category": "brand safety",
      "patterns": [
        "\\bguerrer[oa]s?\\b",
        "\\btribus?\\b",
        "\\btribal(?:es)?\\b",
        "\\b[Gg]rito de guerra\\b",
        "\\b[Pp]ipa de la paz\\b",
        "\\b[Aa]nimal espiritual\\b",
        "\\b[Tt]omahawks?\\b",
        "\\bcabelleras?\\b",
        "\\bpenachos?\\b",
        "\\bNoles\\b",
        "\\bSeminoles\\b"
      ],
      "message": "Imágenes o lenguaje indígena (BRIEF 0.3).",
      "suggest": "Usa el condado: Lake Monroe, SunRail, la Ciudad del Apio, el grupo.",
      "flags": "gu",
      "about": "Case-sensitive on purpose: Guerrero is a common surname."
    },
    {
      "id": "candidate-names",
      "severity": "error",
      "gate": "B33",
      "lang": "any",
      "flags": "gu",
      "category": "brand safety",
      "patterns": [
        "\\bDavid Jolly\\b",
        "\\bJolly\\b",
        "\\bByron Donalds\\b",
        "\\bDonalds\\b",
        "\\b(?:Donald )?Trump\\b",
        "\\bDeSantis\\b",
        "\\bBiden\\b",
        "\\bKamala\\b",
        "\\b(?:JD|J\\. ?D\\.) Vance\\b",
        "\\bRubio\\b",
        "\\bRick Scott\\b",
        "\\bAshley Moody\\b",
        "\\bJay Collins\\b",
        "\\bNewsom\\b",
        "\\bOcasio-Cortez\\b",
        "\\bAOC\\b",
        "\\bObama\\b",
        "\\bBernie Sanders\\b",
        "\\bMaxwell Frost\\b",
        "\\bPete Buttigieg\\b",
        "\\bMamdani\\b"
      ],
      "message": "Candidate or politician named on the site (BRIEF 0.3: write \"the Democrat\" / \"the Republican\"; no politicians as endorsers).",
      "suggest": "the Democrat, the Republican, the governor's race"
    },
    {
      "id": "ages-40-and-under",
      "severity": "error",
      "gate": "N2",
      "lang": "en",
      "category": "honest labels",
      "patterns": [
        "\\b40 (?:and|&|or) (?:under|younger|below)\\b",
        "\\bages? 14 ?(?:to|-|\\u2013|through) ?40\\b",
        "\\bunder 41\\b",
        "\\bup to (?:age )?40\\b"
      ],
      "message": "Membership ages are 14 to 39, or under 40 (BRIEF 0.2, report 00).",
      "suggest": "ages 14 to 39 / under 40"
    },
    {
      "id": "ages-40-and-under-es",
      "severity": "error",
      "gate": "N2",
      "lang": "es",
      "category": "honest labels",
      "patterns": [
        "\\b40 (?:años )?(?:o|y) (?:menos|menores)\\b",
        "\\bhasta (?:los )?40\\b",
        "\\bde 14 a 40\\b",
        "\\bmenores de 41\\b"
      ],
      "message": "Las edades son de 14 a 39 años, o menores de 40.",
      "suggest": "de 14 a 39 años / menores de 40"
    },
    {
      "id": "naming",
      "severity": "error",
      "gate": "N2",
      "lang": "any",
      "category": "honest labels",
      "patterns": [
        "\\bYoung Sem Dems?\\b",
        "\\bYoung Seminole Democrats\\b",
        "\\byoungsemdem\\b",
        "\\bJ[oó]venes Dem[oó]cratas de Seminole\\b"
      ],
      "message": "Use the real name: Young Democrats of Seminole County, YDSC or Young Dems (BRIEF 1.3).",
      "suggest": "Young Democrats of Seminole County / Young Dems / los Young Dems"
    },
    {
      "id": "chat-labels",
      "severity": "error",
      "gate": "B24",
      "lang": "any",
      "category": "honest labels",
      "patterns": [
        "\\b(?:join|get in(?:to)?) the (?:group )?chat\\b",
        "\\b(?:[uú]nete|entra|metete|m[eé]tete) al chat\\b"
      ],
      "message": "There is no chat; \"Join the chat\" was killed (BRIEF 0, 2.6).",
      "suggest": "Join free / Únete gratis; Send it to the group chat is fine for sharing"
    },
    {
      "id": "slang-costume",
      "severity": "error",
      "gate": "B26",
      "lang": "en",
      "category": "voice",
      "patterns": [
        "\\bslay(?:s|ed|ing)?\\b",
        "\\byas+\\b",
        "\\bno cap\\b",
        "\\bbesties?\\b",
        "\\brizz\\b",
        "\\bdelulu\\b",
        "\\bit'?s giving\\b",
        "\\bunderstood the assignment\\b",
        "\\bmain character\\b",
        "\\bgen z is in the house\\b",
        "\\bbussin\\b",
        "\\bperiodt\\b"
      ],
      "message": "Slang the brand doesn't wear (BRIEF 2.6: members bring slang, the brand doesn't).",
      "suggest": "Plain, warm words: show up, bring a friend, first time? perfect."
    },
    {
      "id": "fossil-talk",
      "severity": "error",
      "gate": "B26",
      "lang": "en",
      "category": "voice",
      "patterns": [
        "\\belecteds\\b",
        "\\bGOTV\\b",
        "\\bturnout universe\\b",
        "\\bstakeholders?\\b",
        "\\bsynerg(?:y|ies|ize)\\b",
        "\\bactualize\\b",
        "\\bmost important election of our (?:life ?time|lives)\\b",
        "\\bsoul of the nation\\b",
        "\\bconstituency caucus\\b"
      ],
      "message": "Insider or fossil talk (report 05 5).",
      "suggest": "Say what it is: the people we elected, getting out the vote, neighbors."
    },
    {
      "id": "fossil-maybe",
      "severity": "warning",
      "gate": "B26",
      "lang": "en",
      "category": "voice",
      "patterns": [
        "\\bthe base\\b",
        "\\bleverage\\b",
        "\\bunprecedented\\b",
        "\\bfolks\\b",
        "\\bthe youth\\b",
        "\\byoung people today\\b"
      ],
      "message": "Check this one: report 05 lists it as insider talk or a label for people.",
      "suggest": "you, we, neighbors, first-timers"
    },
    {
      "id": "panic-fundraising",
      "severity": "error",
      "gate": "B24",
      "lang": "en",
      "category": "no guilt, no fake urgency",
      "patterns": [
        "\\bFINAL NOTICE\\b",
        "\\bwe noticed you\\b",
        "\\byou haven'?t (?:given|donated|chipped in|joined) yet\\b",
        "\\byour membership (?:will )?lapse",
        "\\bwe'?re begging\\b",
        "\\b\\d{2,4} ?% match",
        "\\b(?:double|triple|quadruple|[2-9]x) match\\b",
        "\\bRe: your (?:donation|gift)\\b",
        "\\bdon'?t let (?:us|them|me|your friends) down\\b",
        "\\byou'?ll regret\\b",
        "\\bdemocracy dies\\b"
      ],
      "message": "Guilt or fake urgency (report 05 4 and 5; BRIEF 2.6).",
      "suggest": "Give a real date and one action, or say \"Don't have it? Come anyway.\""
    },
    {
      "id": "urgent-caps",
      "severity": "error",
      "gate": "B24",
      "lang": "any",
      "flags": "gu",
      "category": "no guilt, no fake urgency",
      "patterns": [
        "\\bURGENT\\b",
        "\\bURGENTE\\b",
        "\\bACT NOW\\b",
        "\\bLAST CHANCE\\b"
      ],
      "message": "All-caps urgency (BRIEF 2.6).",
      "suggest": "A real date in plain case: \"Requests from before Nov 3 end Dec 31.\""
    },
    {
      "id": "fake-urgency-maybe",
      "severity": "warning",
      "gate": "B24",
      "lang": "en",
      "category": "no guilt, no fake urgency",
      "patterns": [
        "\\blast chance\\b",
        "\\bact now\\b",
        "\\bbefore it'?s too late\\b",
        "\\bhurry\\b",
        "\\btime is running out\\b",
        "\\bonly \\d+ (?:spots|seats|tickets) left\\b",
        "\\bdon'?t miss out\\b"
      ],
      "message": "Urgency is allowed only when a date is real (BRIEF 2.2: Urgent 3). Check this line has one.",
      "suggest": "State the date: \"Seats are first come; the room holds 40.\""
    },
    {
      "id": "guilt-es",
      "severity": "error",
      "gate": "B24",
      "lang": "es",
      "category": "no guilt, no fake urgency",
      "patterns": [
        "\\b[uú]ltimo aviso\\b",
        "\\bnotamos que (?:no|a[uú]n no)\\b",
        "\\bno nos (?:falles|defraudes)\\b",
        "\\bte vas a arrepentir\\b",
        "\\bte lo suplicamos\\b"
      ],
      "message": "Culpa o urgencia falsa (BRIEF 2.6).",
      "suggest": "Una fecha real y una acción."
    },
    {
      "id": "ableist",
      "severity": "error",
      "gate": "B26",
      "lang": "en",
      "category": "respect",
      "patterns": [
        "\\bcrazy\\b",
        "\\binsane(?:ly)?\\b",
        "\\blame\\b",
        "\\bblind to\\b",
        "\\btone[- ]deaf\\b",
        "\\bfalls? on deaf ears\\b",
        "\\bcrippl(?:e|ed|ing)\\b",
        "\\bpsycho\\b",
        "\\bspaz\\b",
        "\\bretard(?:ed)?\\b"
      ],
      "message": "Ableist filler (report 05 5).",
      "suggest": "wild, intense, packed, overlooked, ignored"
    },
    {
      "id": "othering",
      "severity": "error",
      "gate": "B26",
      "lang": "any",
      "category": "respect",
      "patterns": [
        "\\bLatinx\\b",
        "\\billegals\\b",
        "\\bthe gays\\b",
        "\\bthe disabled\\b",
        "\\blow[- ]information voters?\\b",
        "\\buneducated voters?\\b",
        "\\bsheeple\\b"
      ],
      "message": "Othering or belittling words (report 05 5; \"Latinx\" stays out of body copy).",
      "suggest": "Latino, Latina, Hispanic; disabled people or people with disabilities; neighbors"
    },
    {
      "id": "lecture-maybe",
      "severity": "warning",
      "gate": "B26",
      "lang": "en",
      "category": "respect",
      "patterns": [
        "\\bwake up\\b",
        "\\bdo your (?:own )?research\\b",
        "\\bsheep\\b"
      ],
      "message": "Reads as scolding voters (report 05 5). Fine if it's literal.",
      "suggest": "Invite, don't scold."
    },
    {
      "id": "game-costume",
      "severity": "error",
      "gate": "B26",
      "lang": "en",
      "category": "no game costume",
      "patterns": [
        "\\bXP\\b",
        "\\+\\d+ ?(?:XP|points?|pts)\\b",
        "\\blevel(?:ed|s)? up\\b",
        "\\blevels? HUD\\b",
        "\\bpress start\\b",
        "\\bplayer select\\b",
        "\\bco-?op mode\\b",
        "\\bbonus round\\b",
        "\\bpower-?ups?\\b",
        "\\bachievement unlocked\\b",
        "\\bsquad cup\\b",
        "\\bleaderboards?\\b",
        "\\borganizer[- ]era\\b",
        "\\b(?:your|my|our|their|organizing|voting|activist|civic)[- ]era\\b"
      ],
      "message": "Game costume, XP or leaderboards were cut (BRIEF 0, 5.5, 5.10).",
      "suggest": "Stickers you collect for organizing; nothing on civic steps; no rankings of people.",
      "allow": [
        "\\b(?:no|not|never|without|isn'?t|aren'?t|won'?t)\\b[^.!?]{0,24}\\b(?:leaderboards?|XP|level)"
      ]
    },
    {
      "id": "era-word",
      "severity": "warning",
      "gate": "B26",
      "lang": "en",
      "flags": "gu",
      "category": "no game costume",
      "patterns": [
        "\\b[Ee]ra\\b"
      ],
      "allow": [
        "\\b(?:Reconstruction|civil rights|Jim Crow|New Deal|Cold War|Progressive|Victorian|pandemic|COVID|Trump|Obama|Reagan) era\\b",
        "\\b(?:organizer|your|my|our|their|organizing|voting|activist|civic)[- ][Ee]ra\\b"
      ],
      "message": "\"era\" is on the banned list as the old quiz name (BRIEF 2.6). Fine for history; rename anything else.",
      "suggest": "How do you show up? / your type"
    },
    {
      "id": "game-costume-es",
      "severity": "error",
      "gate": "B26",
      "lang": "es",
      "category": "no game costume",
      "patterns": [
        "\\bXP\\b",
        "\\bsube de nivel\\b",
        "\\bsubir de nivel\\b",
        "\\btabla de (?:posiciones|l[ií]deres|clasificaci[oó]n)\\b",
        "\\bclasificaci[oó]n de (?:miembros|personas)\\b",
        "\\bmodo cooperativo\\b",
        "\\bronda extra\\b",
        "\\blogro desbloqueado\\b"
      ],
      "message": "Disfraz de videojuego (BRIEF 0, 5.5).",
      "suggest": "Calcomanías por organizar; nada por votar.",
      "allow": [
        "\\b(?:no|nunca|sin|ni)\\b[^.!?]{0,24}\\b(?:tabla|clasificaci|XP|nivel)"
      ]
    },
    {
      "id": "click-here",
      "severity": "error",
      "gate": "B24",
      "lang": "any",
      "category": "links",
      "patterns": [
        "\\bclick here\\b",
        "\\bclick this link\\b",
        "\\bhaz clic aqu[ií]\\b",
        "\\bpulsa aqu[ií]\\b",
        "\\bclic aqu[ií]\\b"
      ],
      "message": "Links say where they go (BRIEF 2.4).",
      "suggest": "Check My Voter Record / Read the sample issue"
    },
    {
      "id": "mail-ballot-overclaim",
      "severity": "error",
      "gate": "B26",
      "lang": "en",
      "category": "facts",
      "patterns": [
        "\\bevery (?:florida )?(?:mail[- ]?(?:in )?ballot |vote[- ]by[- ]mail |vbm |absentee )?requests? (?:in florida )?(?:expires|expire|ends|end|runs out|run out|lapses|lapse)\\b",
        "\\ball (?:florida )?(?:mail[- ]?(?:in )?ballot |vote[- ]by[- ]mail |vbm )?requests (?:expire|end|run out|lapse)\\b",
        "\\bdeadline to renew\\b",
        "\\brenewal deadline\\b",
        "\\bdec(?:ember)?\\.? 31(?:st)? is the deadline\\b",
        "\\b(?:can'?t|cannot|can not|won'?t be able to) (?:renew|re-?request|request (?:a|your) (?:new )?mail ballot) (?:before|until) jan(?:uary)?\\b"
      ],
      "message": "Mail-ballot overclaim. Only requests made before Nov 3, 2026 end Dec 31 (report 00, corrected ruling; BRIEF 9).",
      "suggest": "Asked for a mail ballot before Nov 3? That request ends Dec 31. Ask again and you should be set through 2028. Check My Voter Record to be sure.",
      "allow": [
        "\\bbefore nov(?:ember)?\\.? 3\\b",
        "\\bmade before\\b",
        "\\bprior to nov"
      ]
    },
    {
      "id": "mail-ballot-overclaim-es",
      "severity": "error",
      "gate": "B26",
      "lang": "es",
      "category": "facts",
      "patterns": [
        "\\btodas las solicitudes\\b.{0,60}\\b(?:vencen|caducan|terminan|expiran)\\b",
        "\\bcada solicitud\\b.{0,60}\\b(?:vence|caduca|termina|expira)\\b",
        "\\bfecha l[ií]mite para renovar\\b",
        "\\bno (?:puedes|podr[aá]s|se puede) (?:renovar|volver a pedir)\\b.{0,30}\\bantes del? (?:1 de )?enero\\b"
      ],
      "message": "Afirmación exagerada sobre la boleta por correo: solo vencen el 31 de dic las solicitudes hechas antes del 3 de nov.",
      "suggest": "¿Pediste tu boleta por correo antes del 3 de nov? Esa solicitud vence el 31 de dic.",
      "allow": [
        "\\bhechas? antes\\b",
        "\\bantes del 3 de nov",
        "\\bantes de las elecciones del 3"
      ]
    },
    {
      "id": "claims-to-avoid",
      "severity": "error",
      "gate": "B30",
      "lang": "en",
      "category": "facts",
      "patterns": [
        "\\byouthquake\\b",
        "\\bmost young voters are independents?\\b",
        "\\bseminole is (?:a )?blue(?: county)?\\b",
        "\\bwekiwa springs\\b.{0,30}\\bin seminole\\b"
      ],
      "allow": [],
      "message": "A claim the brief says to avoid (BRIEF 9).",
      "suggest": "The biggest group of young Seminole voters isn't registered with any party (34.3%)."
    },
    {
      "id": "official-site",
      "severity": "error",
      "gate": "B30",
      "lang": "en",
      "category": "facts",
      "patterns": [
        "\\bofficial (?:web)?site of\\b"
      ],
      "allow": [
        "\\bnot (?:an?|the) official (?:web)?site of\\b",
        "\\bnot yet an official\\b"
      ],
      "message": "Never claim to be an official site of anything (BRIEF 9).",
      "suggest": "Not an official site of the Seminole County Democrats, Florida Young Democrats or any party organization."
    },
    {
      "id": "promise-maybe",
      "severity": "warning",
      "gate": "B30",
      "lang": "en",
      "category": "facts",
      "patterns": [
        "\\brides (?:are )?(?:available|provided)\\b",
        "\\bASL (?:is )?provided\\b",
        "\\breceipts page\\b"
      ],
      "message": "Only when the chapter confirms it (BRIEF 9). Event copy says \"tell us and we'll do our best\".",
      "suggest": "Need a ride or ASL? Tell us and we'll do our best."
    },
    {
      "id": "celebrity",
      "severity": "error",
      "gate": "B26",
      "lang": "any",
      "category": "voice",
      "patterns": [
        "\\bDua Lipa\\b",
        "\\bService ?95\\b"
      ],
      "message": "The Service95 voice is a craft reference only (BRIEF 2.1).",
      "suggest": "Write as the bylined demo member."
    },
    {
      "id": "profanity",
      "severity": "error",
      "gate": "B26",
      "lang": "any",
      "category": "voice",
      "patterns": [
        "\\bf+u+c+k\\w*",
        "\\bshit\\w*",
        "\\bbitch\\w*",
        "\\bmierda\\b",
        "\\bcabr[oó]n\\b",
        "\\bpendej[oa]s?\\b"
      ],
      "message": "No profanity in site copy (report 05 5).",
      "suggest": ""
    },
    {
      "id": "alcohol",
      "severity": "error",
      "gate": "B33",
      "lang": "any",
      "category": "brand safety",
      "scope": "html",
      "patterns": [
        "\\bbeers?\\b",
        "\\bwine\\b",
        "\\bcocktails?\\b",
        "\\bshots? of\\b",
        "\\bhappy hour\\b",
        "\\bbrewery\\b",
        "\\bcerveza\\b",
        "\\bvino\\b"
      ],
      "allow": [
        "\\balcohol[- ]free\\b",
        "\\bsin alcohol\\b",
        "\\bno alcohol\\b"
      ],
      "message": "Members start at 14 and events are alcohol-free (BRIEF 3.6): check copy and alt text.",
      "suggest": "coffee, snacks, a taco truck"
    },
    {
      "id": "time-format",
      "severity": "error",
      "gate": "B26",
      "lang": "en",
      "flags": "gu",
      "category": "format",
      "patterns": [
        "\\b\\d{1,2}(?::\\d{2})? ?(?:AM|PM|A\\.M\\.|P\\.M\\.)(?![\\w])",
        "\\b\\d{1,2}(?::\\d{2})? ?[ap]\\.m\\.(?!\\w)"
      ],
      "message": "Times are lowercase am/pm with a space: \"7 pm\", \"10:30 am\" (BRIEF 2.4).",
      "suggest": "7 pm"
    },
    {
      "id": "time-format-maybe",
      "severity": "warning",
      "gate": "B26",
