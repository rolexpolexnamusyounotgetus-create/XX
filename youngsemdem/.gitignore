# Young Seminole Democrats site: generated and local-only files.

# Node (Playwright is preinstalled globally; nothing is required locally)
node_modules/
npm-debug.log*
package-lock.json

# Tool output
tools/check_report.json
tools/.cache/
test-results/
playwright-report/
