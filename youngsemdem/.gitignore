*.pyc

# Local config override (assets/js/config.js documents it). Production values go in config.js.
assets/js/config.local.js

# Secrets for local function runs: never commit
.env
.env.*
.dev.vars

# Host CLIs
.netlify/
.wrangler/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
