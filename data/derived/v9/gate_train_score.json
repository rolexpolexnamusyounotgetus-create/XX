 "rules": {
  "comparator": "cmp4 = every v9 flag off (= engine 4.0.0 bit for bit, tests/test_v9.js) on the same honest inputs, same fights, common random numbers",
  "candidate": "arm 'all' = the v9 candidate as selected: components.judgeWF + components.format on, components.levels off (the 2019-2020 rolling-origin choice kept no level tracker, data/derived/v9/levels_select.json)",
  "scope": "rolling origin: choices made on 2019-2020 (judging recipe, tracker keep/drop, dispersion), the binding checks G1, G2 and G7 on the 2021-2023 train fights; G6 on the 2019-2023 five-round fights and between-round intervals (the plan's '2019-23 rate'); levels always from earlier fights",
  "checks": {
   "G1": "year-level base-rate error falls (CI < 0 on 2021-23) for each of sig landed per 15, accuracy (sig landed / sig attempted), KD per 100 head landed, TD (landed) per 15, control per 15 and finish rate: statistic = mean over 2021, 2022, 2023 of |sim_year - actual_year| (evalv.js pooled ratios within each year), candidate minus cmp4; CI from 20,000 event-cluster resamples stratified by year (cards resampled within their year); pass iff the CI upper bound < 0 for ALL six (a marginal bound is decided by the normal bound mean + 1.96 x bootstrap sd)",
   "G2a": "sig-landed deviance on 2021-23 improves: per-fight Poisson deviance of sig landed (mean of the two fighters), paired, CI upper < 0",
   "G2b": "total stat deviance not worse: the mean relative 10-stat deviance (tools/v8_gate.py 'total': per fight the mean over the 10 stats of the deviance divided by cmp4's mean of that stat) paired difference CI upper <= +0.005 (+0.5% of level, the plan's 6.3 / 7.1 item 4 stat-line 'not worse' tolerance)",
   "G3": "per-card stacks vs annual-static stacks: NOT APPLICABLE. v9's base (v4, the latest kept version) has no predict() package and no stack weight provider, and the verified calibration study (research/model_calib.md) found no per-card / recency scheme that beats the incumbents on the forward-chained 2021-23 gate; the component is not built",
   "G4": "method-head offsets vs static intercepts: NOT APPLICABLE. The eradrift verifier did not adopt method-level offsets (nested forward-chained 2021-23 gate: 7-bin -0.00007 [-0.00167, +0.00144]), and v4 has no method head; the component is not built",
   "G5": "replayed over 2015-23, the drift rule fires at most once: rule 6.5.1 (b) as pre-registered (a one-way switch) on the stored 2015-2023 quarterly replay checks (data/derived/calib.json rule.replay_2015_2023), switch events <= 1; the trigger-condition count and episodes are reported (research/model_calib.md: the criterion is vacuous for a one-way rule)",
   "G6a": "5-round R4 KO-type hazard covers the real value: 95% event-cluster CI of (sim - actual) hazard of a KO/TKO (doctor / corner included) in round 4 among 5-round fights that reached round 4, 2019-2023, contains 0",
   "G6b": "5-round R5 SUB hazard covers the real value: the same for a submission in round 5 among fights that reached round 5",
   "G6c": "doctor / corner <= 1.5 x the 2019-23 rate: simulated between-round stoppages per round-interval reached (both formats) <= 1.5 x the actual 2019-2023 rate (point estimates; actual = method DOC, or KO/TKO at 5:00 of a round before the last)",
   "G7": "winner log loss, 7-bin and method on 2021-23: paired CI upper <= +0.002 each"
  },
  "pass": "the gate passes iff every applicable check (G1, G2a, G2b, G5, G6a, G6b, G6c, G7 x 3) passes; G3 and G4 are recorded as not applicable",
  "bootstrap": "20,000 event-cluster resamples (card = event + date), seed 7; Monte Carlo SE of each bound (10 batches); a bound within 2 MC SE of its threshold is decided by the clustered normal bound (G1: mean + 1.96 x bootstrap sd)",
  "descriptive_only": "leave-one-out arms -judgeWF / -format and the +levels arm (every tracker on, as designed before the 2019-2020 choice) are scored the same way and reported; they cannot change the decision or re-enter v9"
 },
